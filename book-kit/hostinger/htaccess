# BSP D&T site on Hostinger (dt.bsphosted.fr): always https; make sure updates reach students straight away
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|webmanifest|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest

# nothing but the built site is served; keep git data private
RedirectMatch 404 /\.git
